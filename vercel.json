{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "stt_view.html", "use": "@vercel/static" },
    { "src": "대화저장형식.txt", "use": "@vercel/static" }
  ],
  "routes": [
